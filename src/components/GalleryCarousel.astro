---
import { galleryPhotos, type Copy, type Locale } from '../data/content';

interface Props {
  locale: Locale;
  t: Copy;
}

const { locale, t } = Astro.props;
const total = galleryPhotos.length;
const initialStatus = t.galleryStatusTemplate.replace('{n}', '1').replace('{total}', String(total));
const filters = [
  { id: 'all', label: t.galleryAll },
  { id: 'stage', label: t.galleryStage },
  { id: 'musicians', label: t.galleryMusicians },
] as const;
---

<div
  class="gallery-carousel"
  data-gallery
  tabindex="0"
  data-prev-label={t.galleryPrev}
  data-next-label={t.galleryNext}
  data-status-template={t.galleryStatusTemplate}
>
  <div class="gallery-filters" role="group" aria-label={t.mediaTitle}>
    {
      filters.map((filter, index) => (
        <button
          class="gallery-filter"
          type="button"
          data-filter={filter.id}
          aria-pressed={index === 0 ? 'true' : 'false'}
        >
          {filter.label}
        </button>
      ))
    }
  </div>
  <div class="gallery-viewport">
    <button
      class="gallery-nav gallery-nav-prev"
      type="button"
      data-prev
      disabled={total <= 1}
      aria-label={t.galleryPrev}
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M14.5 5.5 8 12l6.5 6.5"></path>
      </svg>
    </button>
    <ul class="gallery-track">
      {
        galleryPhotos.map((photo, index) => (
          <li
            class:list={['gallery-slide', index === 0 && 'is-active']}
            data-slide
            data-index={index}
            data-group={photo.group}
            aria-hidden={index === 0 ? 'false' : 'true'}
          >
            <figure class="gallery-frame">
              <img
                src={photo.src}
                srcset={photo.srcSet}
                sizes="(min-width: 980px) 48rem, 100vw"
                width={photo.width}
                height={photo.height}
                alt={photo.alt[locale]}
                loading={index === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </figure>
          </li>
        ))
      }
    </ul>
    <button
      class="gallery-nav gallery-nav-next"
      type="button"
      data-next
      disabled={total <= 1}
      aria-label={t.galleryNext}
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M9.5 5.5 16 12l-6.5 6.5"></path>
      </svg>
    </button>
  </div>
  <p class="gallery-status" aria-live="polite">
    <span class="visually-hidden">{t.galleryStatusLabel}:</span>
    <span data-gallery-status>{initialStatus}</span>
  </p>
</div>

<script>
  const carousels = document.querySelectorAll<HTMLElement>('[data-gallery]');
  carousels.forEach((root) => {
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-slide]'));
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-next]');
    const status = root.querySelector<HTMLElement>('[data-gallery-status]');
    const filterButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const prevLabel = root.dataset.prevLabel ?? 'Previous photo';
    const nextLabel = root.dataset.nextLabel ?? 'Next photo';
    const statusTemplate = root.dataset.statusTemplate ?? '{n} / {total}';
    if (!prev || !next || slides.length === 0) return;

    let filter = 'all';
    let index = 0;

    const visibleSlides = () =>
      slides.filter((slide) => filter === 'all' || slide.dataset.group === filter);

    const formatStatus = (current: number, total: number) =>
      statusTemplate.replace('{n}', String(current)).replace('{total}', String(total));

    const setSlide = (nextIndex: number) => {
      const visible = visibleSlides();
      const total = visible.length;
      if (total === 0) return;
      index = ((nextIndex % total) + total) % total;
      slides.forEach((slide) => {
        const shown = visible.includes(slide);
        const active = shown && slide === visible[index];
        slide.hidden = !shown;
        slide.classList.toggle('is-active', active);
        slide.setAttribute('aria-hidden', String(!active));
      });
      if (status) status.textContent = formatStatus(index + 1, total);
      const disabled = total <= 1;
      prev.disabled = disabled;
      next.disabled = disabled;
    };

    const setFilter = (nextFilter: string) => {
      filter = nextFilter;
      filterButtons.forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.filter === filter));
      });
      setSlide(0);
    };

    prev.setAttribute('aria-label', prevLabel);
    next.setAttribute('aria-label', nextLabel);

    prev.addEventListener('click', () => setSlide(index - 1));
    next.addEventListener('click', () => setSlide(index + 1));
    filterButtons.forEach((button) => {
      button.addEventListener('click', () => setFilter(button.dataset.filter ?? 'all'));
    });

    root.addEventListener('keydown', (event) => {
      if (event.target instanceof HTMLButtonElement && event.target.dataset.filter) return;
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        setSlide(index - 1);
      }
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        setSlide(index + 1);
      }
    });

    setSlide(0);
  });
</script>
