---
import type { Copy, Locale } from '../data/content';

interface Props {
  locale: Locale;
  t: Copy;
}

const { locale, t } = Astro.props;
const otherHref = locale === 'el' ? '/en/' : '/';
const otherLabel = locale === 'el' ? 'EN' : 'ΕΛ';
const otherName = locale === 'el' ? 'English' : 'Ελληνικά';
---

<a class="skip" href="#main">{t.skip}</a>
<header class="site-header">
  <a class="wordmark" href={locale === 'el' ? '/#top' : '/en/#top'}>Εσμιγιά</a>
  <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
    {t.menu}
  </button>
  <nav class="site-nav" id="site-nav" aria-label={locale === 'el' ? 'Κύρια' : 'Main'}>
    {
      t.nav.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))
    }
    <div class="lang-switch">
      <a href={locale === 'el' ? '/#top' : '/en/#top'} aria-current="true" lang={locale}>
        {locale === 'el' ? 'ΕΛ' : 'EN'}
      </a>
      <span aria-hidden="true">/</span>
      <a href={otherHref} data-lang-switch hreflang={locale === 'el' ? 'en' : 'el'} lang={locale === 'el' ? 'en' : 'el'} aria-label={otherName}>
        {otherLabel}
      </a>
    </div>
  </nav>
</header>
