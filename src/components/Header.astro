---
import type { Copy, Locale } from '../data/content';

interface Props {
  locale: Locale;
  t: Copy;
}

const { locale, t } = Astro.props;
---

<a class="skip" href="#main">{t.skip}</a>
<header class="site-header">
  <a class="wordmark" href={locale === 'el' ? '/#top' : '/en/#top'}>{t.footer}</a>
  <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
    {t.menu}
  </button>
  <nav class="site-nav" id="site-nav" aria-label={locale === 'el' ? 'Κύρια' : 'Main'}>
    {
      t.nav.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))
    }
    <div class="lang-switch">
      <a href="/#top" lang="el" hreflang="el" aria-label="Ελληνικά" aria-current={locale === 'el' ? 'true' : undefined}>
        ΕΛ
      </a>
      <span aria-hidden="true">/</span>
      <a href="/en/#top" lang="en" hreflang="en" aria-label="English" aria-current={locale === 'en' ? 'true' : undefined}>
        EN
      </a>
    </div>
  </nav>
</header>
