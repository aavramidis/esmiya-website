---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import GalleryCarousel from './GalleryCarousel.astro';
import MusicPlayer from './MusicPlayer.astro';
import {
  dictionary,
  featuredVideo,
  instruments,
  listeningLens,
  members,
  portrait,
  type Locale,
} from '../data/content';
import { structuredData } from '../data/schema';
import '../styles/global.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dictionary[locale];
const canonicalPath = locale === 'el' ? '/' : '/en/';

const jsonLd = JSON.stringify(structuredData(locale)).replace(/</g, '\\u003c');
---

<Base
  locale={locale}
  title={t.title}
  description={t.description}
  canonicalPath={canonicalPath}
  imageAlt={t.portraitAlt}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={jsonLd} />
  </Fragment>
  <Header locale={locale} t={t} />
  <main id="main">
    <section class="hero" id="top">
      <div class="hero-copy">
        <p class="kicker">{t.heroKicker}</p>
        <h1>{t.heroTitle}</h1>
        {t.heroLatin && <p class="latin">{t.heroLatin}</p>}
        <p class="lead">{t.heroLead}</p>
        <p class="support">{t.heroSupport}</p>
        <p class="instruments">{t.instruments}</p>
        <div class="hero-actions">
          <a class="button button-fill" href="#music">{t.ctaMusic}</a>
          <a class="button button-line" href="#about">{t.ctaAbout}</a>
        </div>
      </div>
      <figure class="hero-frame">
        <img
          src={portrait.src}
          srcset={portrait.srcSet}
          sizes="(min-width: 800px) 52vw, 100vw"
          width={portrait.width}
          height={portrait.height}
          alt={t.portraitAlt}
          fetchpriority="high"
        />
      </figure>
    </section>

    <section class="section" id="about">
      <div class="section-inner">
        <p class="kicker">{t.aboutKicker}</p>
        <h2>{t.aboutTitle}</h2>
        <div class="about-body">
          {t.aboutBody.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <blockquote class="statement">{t.aboutQuote}</blockquote>
      </div>
    </section>

    <section class="section band-dark" id="music">
      <div class="section-inner">
        <p class="kicker">{t.musicKicker}</p>
        <h2>{t.musicTitle}</h2>
        <div class="music-intro">
          {t.musicIntro.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <h3 class="block-heading">{t.recordingsLabel}</h3>
        <MusicPlayer locale={locale} t={t} />
        <div class="video-block" id={featuredVideo.id}>
          <h3 class="video-heading">{t.videosLabel}</h3>
          <div class="video-frame">
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${featuredVideo.youtubeId}`}
              title={featuredVideo.title[locale]}
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
              loading="lazy"
              referrerpolicy="strict-origin-when-cross-origin"
            />
          </div>
          <p class="video-label">{t.liveLabel}</p>
          <p class="video-caption">{featuredVideo.title[locale]}</p>
          <p class="video-desc">{featuredVideo.description[locale]}</p>
        </div>
      </div>
    </section>

    <section class="section" id="sound">
      <div class="section-inner">
        <p class="kicker">{t.soundKicker}</p>
        <h2>{t.soundTitle}</h2>
        <div class="identity-body">
          {t.soundBody.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <ul class="sound-grid">
          {
            instruments.map((instrument) => (
              <li class="sound-card">
                <h3>{instrument.name[locale]}</h3>
                <p>{instrument.text[locale]}</p>
              </li>
            ))
          }
        </ul>
        <h3 class="listen-title">{t.listenForTitle}</h3>
        <ul class="listen-grid">
          {
            listeningLens.map((item) => (
              <li class="listen-card">
                <h4>{item.title[locale]}</h4>
                <p>{item.text[locale]}</p>
              </li>
            ))
          }
        </ul>
        <blockquote class="statement identity-close">
          {t.soundClose.map((line) => <p>{line}</p>)}
        </blockquote>
      </div>
    </section>

    <section class="section" id="media">
      <div class="section-inner">
        <p class="kicker">{t.mediaKicker}</p>
        <h2>{t.mediaTitle}</h2>
        <GalleryCarousel locale={locale} t={t} />
      </div>
    </section>

    <section class="section" id="members" style="padding-top: 0">
      <div class="section-inner">
        <p class="kicker">{t.membersKicker}</p>
        <h2>{t.membersTitle}</h2>
        <div class="member-grid">
          {
            members.map((member) => {
              const name = member.name[locale];
              const role = member.role[locale];
              return (
                <article class="member-card" id={member.schemaId} data-id={member.id}>
                  <div
                    class="member-photo"
                    style={member.photoAspect ? `aspect-ratio: ${member.photoAspect}` : undefined}
                  >
                    {member.image ? (
                      <img
                        src={member.image}
                        alt={locale === 'el' ? `${name} της Εσμιγιάς, ${role}` : `${name} of Esmiya, ${role}`}
                        loading="lazy"
                      />
                    ) : (
                      <div class="member-photo-empty" aria-hidden="true">
                        <span>{member.initials}</span>
                      </div>
                    )}
                  </div>
                  <div class="member-copy">
                    <p class="role">{role}</p>
                    <h3>{name}</h3>
                  </div>
                </article>
              );
            })
          }
        </div>
      </div>
    </section>

    <section class="section" id="contact" style="padding-top: 0">
      <div class="section-inner">
        <p class="kicker">{t.contactKicker}</p>
        <h2>{t.contactTitle}</h2>
        <p class="section-lead">{t.contactBody}</p>
        <p class="section-lead">{t.contactLead}</p>
        <div class="contact-actions">
          <a class="button button-fill" href={`mailto:${t.email}`}>{t.contactCta}</a>
        </div>
        <a class="email" href={`mailto:${t.email}`}>{t.email}</a>
      </div>
    </section>
  </main>
  <Footer t={t} />
</Base>
