---
import { tracks, type Copy, type Locale } from '../data/content';

interface Props {
  locale: Locale;
  t: Copy;
}

const { locale, t } = Astro.props;

const formatTime = (seconds: number) => {
  const m = Math.floor(seconds / 60);
  const s = Math.floor(seconds % 60);
  return `${m}:${String(s).padStart(2, '0')}`;
};
---

<div
  class="player"
  data-player
  data-play-label={t.play}
  data-pause-label={t.pause}
  data-now-playing={t.nowPlaying}
  data-artist={t.footer}
  data-mute-label={t.mute}
  data-unmute-label={t.unmute}
>
  <ol class="playlist">
    {
      tracks.map((track) => {
        const title = track.title[locale];
        return (
          <li class="track" data-track data-title={title} data-src={track.src}>
            <button
              class="play-btn"
              type="button"
              data-play
              aria-pressed="false"
              aria-label={`${t.play}: ${title}`}
            >
              <svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M8 5.5v13l11-6.5-11-6.5Z"></path>
              </svg>
              <svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M7 5h3.4v14H7V5Zm6.6 0H17v14h-3.4V5Z"></path>
              </svg>
            </button>
            <div class="track-body">
              <div class="track-heading">
                <h3>{title}</h3>
                <p class="track-blurb">{track.blurb[locale]}</p>
                <p class="track-note">
                  <span data-duration>{formatTime(track.duration)}</span>
                </p>
              </div>
              <div class="track-controls">
                <span class="time" data-current>
                  0:00
                </span>
                <input
                  class="seek"
                  type="range"
                  min="0"
                  max="1000"
                  value="0"
                  step="1"
                  data-seek
                  aria-label={t.seek}
                  aria-valuemin="0"
                  aria-valuemax="1000"
                  aria-valuenow="0"
                />
                <span class="time" data-remaining>{formatTime(track.duration)}</span>
              </div>
              <p class="track-error" data-error hidden>{t.audioError}</p>
            </div>
            <audio
              src={track.src}
              preload="metadata"
              playsinline
              webkit-playsinline
              data-audio
            ></audio>
          </li>
        );
      })
    }
  </ol>
  <div class="player-volume">
    <button class="volume-btn" type="button" data-mute aria-pressed="false" aria-label={t.mute}>
      <svg class="icon-volume" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 9v6h4l5 5V4L8 9H4Zm11.5 3c0-1.77-1.02-3.29-2.5-4.03v8.06c1.48-.74 2.5-2.26 2.5-4.03ZM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77 0-4.28-2.99-7.86-7-8.77Z"></path>
      </svg>
      <svg class="icon-muted" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 9v6h4l5 5V4L8 9H4Zm11.5 3c0-1.77-1.02-3.29-2.5-4.03v8.06c1.48-.74 2.5-2.26 2.5-4.03ZM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77 0-4.28-2.99-7.86-7-8.77Z"></path>
        <path d="M3.27 3 2 4.27l7.73 7.73H2v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73 3.27 3Z"></path>
      </svg>
    </button>
    <input
      class="seek volume-range"
      type="range"
      min="0"
      max="100"
      value="100"
      step="1"
      data-volume
      aria-label={t.volume}
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="100"
    />
  </div>
</div>

<script>
  const formatTime = (seconds: number) => {
    if (!Number.isFinite(seconds) || seconds < 0) return '0:00';
    const whole = Math.floor(seconds);
    const m = Math.floor(whole / 60);
    const s = whole % 60;
    return `${m}:${String(s).padStart(2, '0')}`;
  };

  const VOLUME_KEY = 'esmiya-volume';

  const player = document.querySelector<HTMLElement>('[data-player]');
  if (player) {
    const playLabel = player.dataset.playLabel ?? 'Play';
    const pauseLabel = player.dataset.pauseLabel ?? 'Pause';
    const nowPlaying = player.dataset.nowPlaying ?? 'Now playing';
    const muteLabel = player.dataset.muteLabel ?? 'Mute';
    const unmuteLabel = player.dataset.unmuteLabel ?? 'Unmute';
    const rows = Array.from(player.querySelectorAll<HTMLElement>('[data-track]'));
    const audios = rows
      .map((row) => row.querySelector<HTMLAudioElement>('[data-audio]'))
      .filter((audio): audio is HTMLAudioElement => Boolean(audio));
    const volumeInput = player.querySelector<HTMLInputElement>('[data-volume]');
    const muteBtn = player.querySelector<HTMLButtonElement>('[data-mute]');

    let lastRow = rows[0];

    const readStoredVolume = () => {
      try {
        const saved = localStorage.getItem(VOLUME_KEY);
        if (saved === null) return 1;
        const value = Number(saved);
        if (!Number.isFinite(value)) return 1;
        return Math.min(1, Math.max(0, value));
      } catch {
        return 1;
      }
    };

    let volumeBeforeMute = readStoredVolume();
    let userMuted = false;

    const paintRange = (input: HTMLInputElement, ratio: number) => {
      const percent = `${Math.min(100, Math.max(0, ratio * 100))}%`;
      input.style.setProperty('--played', percent);
    };

    const syncMuteButton = (muted: boolean) => {
      if (!muteBtn) return;
      muteBtn.setAttribute('aria-pressed', String(muted));
      muteBtn.setAttribute('aria-label', muted ? unmuteLabel : muteLabel);
      muteBtn.dataset.muted = muted ? 'true' : 'false';
    };

    const applyVolume = (level: number, { persist = true } = {}) => {
      const clamped = Math.min(1, Math.max(0, level));
      audios.forEach((audio) => {
        audio.volume = clamped;
        audio.muted = userMuted || clamped === 0;
      });
      if (volumeInput) {
        const sliderValue = String(Math.round(clamped * 100));
        volumeInput.value = sliderValue;
        volumeInput.setAttribute('aria-valuenow', sliderValue);
        paintRange(volumeInput, clamped);
      }
      syncMuteButton(userMuted || clamped === 0);
      if (persist) {
        try {
          localStorage.setItem(VOLUME_KEY, String(clamped));
        } catch {
          /* ignore */
        }
      }
    };

    const setPlaying = (row: HTMLElement, playing: boolean) => {
      const button = row.querySelector<HTMLButtonElement>('[data-play]');
      const title = row.dataset.title ?? '';
      row.dataset.playing = playing ? 'true' : 'false';
      button?.setAttribute('aria-pressed', String(playing));
      button?.setAttribute('aria-label', `${playing ? pauseLabel : playLabel}: ${title}`);
      if (playing) lastRow = row;
    };

    const pauseOthers = (active: HTMLElement) => {
      rows.forEach((row) => {
        if (row === active) return;
        const other = row.querySelector('audio');
        if (other && !other.paused) other.pause();
        setPlaying(row, false);
      });
    };

    const updateMediaSession = (row: HTMLElement, audio: HTMLAudioElement) => {
      if (!('mediaSession' in navigator)) return;
      navigator.mediaSession.metadata = new MediaMetadata({
        title: row.dataset.title ?? '',
        artist: player.dataset.artist ?? 'Esmiya',
        album: nowPlaying,
      });
      navigator.mediaSession.playbackState = audio.paused ? 'paused' : 'playing';
    };

    rows.forEach((row, index) => {
      const audio = row.querySelector<HTMLAudioElement>('[data-audio]');
      const button = row.querySelector<HTMLButtonElement>('[data-play]');
      const seek = row.querySelector<HTMLInputElement>('[data-seek]');
      const current = row.querySelector<HTMLElement>('[data-current]');
      const remaining = row.querySelector<HTMLElement>('[data-remaining]');
      const durationLabel = row.querySelector<HTMLElement>('[data-duration]');
      const error = row.querySelector<HTMLElement>('[data-error]');
      if (!audio || !button || !seek || !current || !remaining) return;

      let scrubbing = false;

      const updateSeekUi = (ratio: number, time: number, duration: number) => {
        const value = String(Math.round(ratio * 1000));
        seek.value = value;
        paintRange(seek, ratio);
        seek.setAttribute('aria-valuenow', value);
        current.textContent = formatTime(time);
        remaining.textContent = formatTime(Math.max(0, duration - time));
      };

      const syncSeek = () => {
        const duration = audio.duration;
        if (!Number.isFinite(duration) || duration <= 0) return;
        if (scrubbing) return;
        const ratio = audio.currentTime / duration;
        updateSeekUi(ratio, audio.currentTime, duration);
      };

      const seekFromSlider = () => {
        const duration = audio.duration;
        if (!Number.isFinite(duration) || duration <= 0) return;
        const ratio = Number(seek.value) / 1000;
        const time = ratio * duration;
        updateSeekUi(ratio, time, duration);
        audio.currentTime = time;
      };

      const stopScrubbing = () => {
        if (!scrubbing) return;
        scrubbing = false;
        seekFromSlider();
        syncSeek();
      };

      button.addEventListener('click', async () => {
        if (audio.paused) {
          pauseOthers(row);
          setPlaying(row, true);
          try {
            if (audio.readyState < 2) audio.load();
            await audio.play();
          } catch {
            setPlaying(row, false);
            error?.removeAttribute('hidden');
          }
        } else {
          setPlaying(row, false);
          audio.pause();
        }
      });

      seek.addEventListener('pointerdown', () => {
        scrubbing = true;
      });
      seek.addEventListener('pointerup', stopScrubbing);
      seek.addEventListener('pointercancel', stopScrubbing);
      seek.addEventListener('input', seekFromSlider);

      audio.addEventListener('play', () => {
        error?.setAttribute('hidden', '');
        setPlaying(row, true);
        updateMediaSession(row, audio);
      });

      audio.addEventListener('pause', () => {
        setPlaying(row, false);
        updateMediaSession(row, audio);
      });

      audio.addEventListener('timeupdate', syncSeek);
      audio.addEventListener('seeked', syncSeek);
      audio.addEventListener('loadedmetadata', () => {
        if (Number.isFinite(audio.duration) && durationLabel) {
          durationLabel.textContent = formatTime(audio.duration);
        }
        syncSeek();
      });

      audio.addEventListener('ended', () => {
        audio.currentTime = 0;
        syncSeek();
        const next = rows[index + 1]?.querySelector<HTMLButtonElement>('[data-play]');
        next?.click();
      });

      audio.addEventListener('error', () => {
        error?.removeAttribute('hidden');
        setPlaying(row, false);
      });
    });

    if (volumeInput && muteBtn) {
      const initialVolume = readStoredVolume();
      volumeBeforeMute = initialVolume > 0 ? initialVolume : 1;
      userMuted = false;
      applyVolume(initialVolume, { persist: false });

      volumeInput.addEventListener('input', () => {
        const level = Number(volumeInput.value) / 100;
        userMuted = false;
        volumeBeforeMute = level > 0 ? level : volumeBeforeMute;
        applyVolume(level);
      });

      muteBtn.addEventListener('click', () => {
        const level = Number(volumeInput.value) / 100;
        if (userMuted || level === 0) {
          userMuted = false;
          applyVolume(volumeBeforeMute > 0 ? volumeBeforeMute : 1);
          return;
        }
        volumeBeforeMute = level;
        userMuted = true;
        audios.forEach((audio) => {
          audio.muted = true;
        });
        syncMuteButton(true);
      });
    }

    if ('mediaSession' in navigator) {
      navigator.mediaSession.setActionHandler('play', () => {
        void lastRow?.querySelector<HTMLAudioElement>('[data-audio]')?.play();
      });
      navigator.mediaSession.setActionHandler('pause', () => {
        lastRow?.querySelector<HTMLAudioElement>('[data-audio]')?.pause();
      });
      navigator.mediaSession.setActionHandler('nexttrack', () => {
        const index = Math.max(0, rows.indexOf(lastRow));
        const next = rows[index + 1] ?? rows[0];
        next?.querySelector<HTMLButtonElement>('[data-play]')?.click();
      });
      navigator.mediaSession.setActionHandler('previoustrack', () => {
        const index = Math.max(0, rows.indexOf(lastRow));
        const current = lastRow?.querySelector<HTMLAudioElement>('[data-audio]');
        if (current && current.currentTime > 3) {
          current.currentTime = 0;
          return;
        }
        const prev = rows[index - 1] ?? rows[rows.length - 1];
        prev?.querySelector<HTMLButtonElement>('[data-play]')?.click();
      });
    }
  }
</script>
